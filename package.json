{
  "name": "verona-widgets-chemistry",
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start:showcase-widgets": "ng serve showcase-widgets --host 0.0.0.0",
    "start:all": "run-s build:all start:showcase-widgets",
    "test:project:verona-widget": "ng test verona-widget",
    "test:project:periodic-system-common": "ng test periodic-system-common",
    "test:project:periodic-system-select-widget": "ng test periodic-system-select-widget",
    "test:project:molecule-editor-widget": "ng test molecule-editor-widget",
    "test:project:calculator-widget": "ng test calculator-widget",
    "test:all": "run-p test:project:*",
    "test:ci": "run-s \"test:project:!(verona-widget) -- --watch=false --browsers=ChromeHeadless\"",
    "watch:project:verona-widget": "ng build verona-widget --watch",
    "watch:project:periodic-system-common": "ng build periodic-system-common --watch",
    "watch:all": "run-p watch:project:*",
    "build:project:verona-widget": "ng build verona-widget",
    "build:project:periodic-system-common": "ng build periodic-system-common",
    "build:project:periodic-system-select-widget": "ng build periodic-system-select-widget",
    "build:project:molecule-editor-widget": "ng build molecule-editor-widget",
    "build:project:calculator-widget": "ng build calculator-widget",
    "build:project:showcase-widgets": "ng build showcase-widgets",
    "build:all": "run-s build:project:verona-widget build:project:periodic-system-common build:project:periodic-system-select-widget build:project:molecule-editor-widget build:project:calculator-widget build:project:showcase-widgets",
    "build:demo": "run-s build:all \"ng build showcase-widgets -- {@}\" --",
    "inline:project:periodic-system-select-widget": "node scripts/pack-html.js dist/periodic-system-select-widget/browser",
    "inline:project:molecule-editor-widget": "node scripts/pack-html.js dist/molecule-editor-widget/browser",
    "inline:project:calculator-widget": "node scripts/pack-html.js dist/calculator-widget/browser",
    "inline:project:showcase-widgets": "node scripts/pack-html.js dist/showcase-widgets/browser",
    "inline:all": "run-p inline:project:*",
    "prettier": "prettier -w projects/*/src/",
    "clean": "rimraf dist/",
    "generate-diagrams": "plantuml -tpng img/diagrams.puml",
    "copy-docs-index": "cp dist/showcase-widgets/browser/index_packed.html docs/index.html"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "~22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "immer": "^11.2.9",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@node-projects/css-parser": "^5.2.0",
    "@types/jasmine": "~6.0.0",
    "inline-source": "^8.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-packagr": "^22.2.5",
    "node-html-parser": "^9.0.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  }
}
